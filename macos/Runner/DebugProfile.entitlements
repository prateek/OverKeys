<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		OverKeys is not sandboxed. A sandboxed app cannot install the global
		CGEventTap that the keyboard overlay relies on, nor open the local TCP
		socket used for Kanata integration. The app ships outside the Mac App
		Store (GitHub releases), so the sandbox is intentionally disabled.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
