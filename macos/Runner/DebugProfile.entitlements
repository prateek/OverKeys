<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		OverKeys is not sandboxed: a sandboxed app cannot install the global
		CGEventTap the keyboard overlay relies on. (The Kanata integration's
		outbound TCP socket isn't the reason — that would only need the
		network.client entitlement.) The app ships outside the Mac App Store
		(GitHub releases), so the sandbox is intentionally disabled.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
